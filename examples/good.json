{
 "policy": {
  "required": [
   {
    "key": "Environment",
    "values": ["prod", "staging", "dev"]
   },
   {
    "key": "Owner",
    "pattern": "[a-z]+\\.[a-z]+"
   },
   {
    "key": "CostCenter",
    "pattern": "CC-[0-9]{4}"
   },
   {
    "key": "DataClass",
    "values": ["public", "internal", "confidential"],
    "kinds": ["bucket", "database"]
   }
  ],
  "forbidden_keys": ["temp-password"],
  "max_tags": 10
 },
 "resources": [
  {
   "name": "orders-db",
   "kind": "database",
   "tags": {
