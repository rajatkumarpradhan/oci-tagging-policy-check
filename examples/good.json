   }
  },
  {
   "name": "web-vm",
   "kind": "compute",
   "tags": {
    "Environment": "staging",
    "Owner": "rajat.kumar",
    "CostCenter": "CC-1002"
   }
  },
  {
   "name": "assets",
   "kind": "bucket",
   "tags": {
    "Environment": "dev",
    "Owner": "rajat.kumar",
    "CostCenter": "CC-1002",
    "DataClass": "public"
   }
  }
 ]
